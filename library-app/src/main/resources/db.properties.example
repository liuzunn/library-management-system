# ============================================================
#  图书管理系统 数据库连接配置（示例）
#
#  用法：复制本文件为 db.properties 再按需修改。
#  db.properties 已被 .gitignore 忽略，不会提交到版本库。
#
#  也可以完全不用本文件，直接用环境变量（优先级更高）：
#     LIBRARY_DB_URL / LIBRARY_DB_USER / LIBRARY_DB_PASSWORD
# ============================================================
jdbc.driver=com.mysql.cj.jdbc.Driver
jdbc.url=jdbc:mysql://127.0.0.1:3306/library_db?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
jdbc.username=root
jdbc.password=在此填入你的口令
